{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/journey/**",
              "components/metrics/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Red Hat Display|Figtree))/i]",
        "message": "Font not provided by the design system. Available: Red Hat Display, Figtree."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChannelChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:channel|label|key|ref|className|style|children)$/]",
        "message": "<ChannelChip> doesn't accept that prop. Declared props: channel, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoalBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:goals|key|ref|className|style|children)$/]",
        "message": "<GoalBox> doesn't accept that prop. Declared props: goals."
      },
      {
        "selector": "JSXOpeningElement[name.name='JourneyNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|label|key|ref|className|style|children)$/]",
        "message": "<JourneyNode> doesn't accept that prop. Declared props: type, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='JourneyNode'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:starter|wait|channel|action|check)$/]",
        "message": "<JourneyNode> type must be one of 'starter' | 'wait' | 'channel' | 'action' | 'check'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|logoHeight|key|ref|className|style|children)$/]",
        "message": "<LogoLockup> doesn't accept that prop. Declared props: variant, logoHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoLockup'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<LogoLockup> variant must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|key|ref|className|style|children)$/]",
        "message": "<MetricStat> doesn't accept that prop. Declared props: value, label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricStat'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<MetricStat> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:segments|audience|key|ref|className|style|children)$/]",
        "message": "<SegmentBox> doesn't accept that prop. Declared props: segments, audience."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "ChannelChip": {
        "replaces": []
      },
      "GoalBox": {
        "replaces": []
